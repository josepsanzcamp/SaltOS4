<root>
    <main default="true">
        <check eval="true" logout="true">current_user()</check>
        <check eval="true">check_app_perm_id(get_data('rest/1'), get_data('rest/2'))</check>
        <gettext eval="true">T()</gettext>
        <screen>type1fluid</screen>
        <navbar eval="true">xmlfile2array('apps/common/xml/navbar.xml')['navbar']</navbar>
        <title>Dashboard</title>
        <javascript>
            <file eval="true">file_with_hash('apps/dashboard/lib/gridstack/gridstack-all.min.js')</file>
            <file eval="true">file_with_hash(file_with_min('apps/dashboard/js/dashboard.js'))</file>
            <inline>saltos.driver.init('main')</inline>
        </javascript>
        <style>
            <file eval="true">file_with_hash('apps/dashboard/lib/gridstack/gridstack.min.css')</file>
            <inline>
                .widget-drag-handle {
                    position: absolute;
                    top: 1px;
                    right: 8px;
                    z-index: 1000;
                    cursor: grab;
                    padding: 2px;
                    transition: opacity .2s;
                    color: #666;
                    text-shadow:
                        0.5px 0 0 #666,
                        0 0.5px 0 #666,
                        0.5px 0.5px 0 #666;
                    opacity: 0;
                }
                .grid-stack-item:hover .widget-drag-handle {
                    opacity: 1;
                }
                .grid-stack {
                    margin: -6px -8px;
                }
            </inline>
        </style>
        <dashboard append="one">
            <widgets require="apps/dashboard/php/dashboard.php" eval="true">__dashboard_helper()</widgets>
            <configs eval="true">get_config_array('app/dashboard/widgets/', current_user())</configs>
        </dashboard>
    </main>

    <config>
        <check eval="true" logout="true">current_user()</check>
        <check eval="true">check_app_perm_id(get_data('rest/1'), get_data('rest/2'))</check>
        <output ifeval="get_data('server/request_method')=='GET'" eval="true">get_config_array('app/dashboard/widgets/', current_user())</output>
        <output ifeval="get_data('server/request_method')=='POST'" eval="true">set_config('app/dashboard/widgets/'.get_data('json/name'), get_data('json/val'), current_user())</output>
    </config>
</root>
