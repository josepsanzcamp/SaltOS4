<root>
    <_form>
        <subtable id="allnotes" label="Notes" col_class="col-12 mb-3" nodata="No notes" require="php/lib/notes.php" ifeval="check_notes(get_data('rest/1'), get_data('rest/2'))">
            <header>
                <user label="User"/>
                <datetime label="Datetime"/>
                <note label="Note"/>
            </header>
            <toolbar>
                <button label="New note" tooltip="Add a new note" icon="plus-lg" color="success" onclick="saltos.common.note_add('allnotes')"/>
                <div col_class="col"/>
                <text nodisable="true" placeholder="Search notes" tooltip="Search in notes" rounded="rounded-pill" onenter="document.getElementById('allnotes').search()"/>
                <button nodisable="true" onclick="document.getElementById('allnotes').search()" tooltip="Search" icon="search"/>
                <button nodisable="true" onclick="document.getElementById('allnotes').clear_search()" tooltip="Reset" icon="x-lg"/>
            </toolbar>
            <actions>
                <edit icon="pencil" tooltip="Edit note" onclick="saltos.common.note_edit"/>
                <delete icon="trash" color="danger" tooltip="Delete note" onclick="saltos.common.note_delete"/>
            </actions>
            <footer>
                <count label="Total: {n}"/>
                <pagination items="10"/>
            </footer>
            <modal title="Note" color="primary" col_class="col-md-12 mb-3">
                <textarea id="note" label="Note" required="true" height="5em" col_class="col-md-12 mb-3"/>
            </modal>
        </subtable>
    </_form>

    <_data require="php/lib/notes.php" eval="true">check_notes(get_data('rest/1'), get_data('rest/2')) ?
        execute_query_array("SELECT id, (SELECT name FROM tbl_users b WHERE b.id=user_id) user, datetime, note
            FROM " . app2table(get_data('rest/1')) . '_notes WHERE reg_id = ? ORDER BY id DESC',
            [intval(get_data('rest/3'))]) : []</_data>
</root>
