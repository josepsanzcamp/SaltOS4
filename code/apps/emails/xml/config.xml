<root>
    <dirs>
        <inboxdir eval="true">getcwd()."/data/inbox"</inboxdir>
        <outboxdir eval="true">getcwd()."/data/outbox"</outboxdir>
    </dirs>
    <emails>
        <imapbatch>100</imapbatch><!-- max emails downloaded by IMAP sync -->
        <imapretries>10</imapretries><!-- max retries of an IMAP queue operation -->
    </emails>
</root>
