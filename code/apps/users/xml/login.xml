<root>
    <main>
        <check eval="true">!current_user()</check>
        <check eval="true">check_app_perm_id(get_data('rest/1'), get_data('rest/2'))</check>
        <gettext eval="true">T()</gettext>
        <title>Login form</title>
        <screen>clear</screen>
        <layout>
            <div id="screen" class="vh-100 d-flex bg-body-secondary">
                <container auto="true" container_class="container m-auto bg-body rounded-4 shadow-sm" col_class="col-12 mb-3 px-5" container_style="max-width:400px">
                    <image col_class="col-12 mb-5 px-0" color="none" class="bg-primary img-fluid" shadow="shadow-0" rounded="rounded-top-4">
                        <value eval="true">get_config('brand/image')</value>
                    </image>
                    <label class="fs-2 w-100 text-center" label="Please login"/>
                    <text id="user" label="Username" required="true" autofocus="true" rounded="rounded-pill" onenter="document.getElementById('pass').focus()"/>
                    <password id="pass" label="Password" required="true" rounded="rounded-pill" onenter="saltos.login.authenticate()"/>
                    <button class="w-100" onclick="saltos.login.authenticate()" label="Login" icon="box-arrow-in-right" col_class="col-12 my-3 px-5 pb-5"/>
                </container>
            </div>
        </layout>
        <javascript>
            <file eval="true">file_with_hash('apps/users/js/login.js')</file>
        </javascript>
    </main>
</root>
