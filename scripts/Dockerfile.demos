
ARG PHP_VERSION=8.5

####################################################################################################
# xlsxio builder
####################################################################################################

FROM debian:trixie AS xlsxio-builder

RUN apt update && apt install -y \
    build-essential \
    cmake \
    git \
    zlib1g-dev \
    expat \
    libexpat1-dev \
    libminizip-dev \
    && rm -rf /var/lib/apt/lists/*

RUN cd /tmp \
    && git clone --depth 1 https://github.com/brechtsanders/xlsxio.git \
    && cd xlsxio \
    && cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_STATIC=NO . \
    && make \
    && make install DESTDIR=/opt/xlsxio-install

####################################################################################################
# default builder
####################################################################################################

FROM debian:trixie

ARG PHP_VERSION

RUN echo 'path-exclude /usr/share/doc/*' > /etc/dpkg/dpkg.cfg.d/01_nodoc && \
    echo 'path-exclude /usr/share/man/*' >> /etc/dpkg/dpkg.cfg.d/01_nodoc && \
    echo 'path-exclude /usr/share/locale/*' >> /etc/dpkg/dpkg.cfg.d/01_nodoc && \
    echo 'APT::Install-Recommends "false";' > /etc/apt/apt.conf.d/00_nofilters && \
    echo 'APT::Install-Suggests "false";' >> /etc/apt/apt.conf.d/00_nofilters

RUN apt update && apt install -y \
    extrepo \
    wget \
    vim \
    net-tools \
    iputils-ping \
    tini \
    && rm -rf /var/lib/apt/lists/*

RUN extrepo enable sury

# php
RUN apt update && apt install -y \
    php${PHP_VERSION}-bcmath \
    php${PHP_VERSION}-cli \
    php${PHP_VERSION}-common \
    php${PHP_VERSION}-curl \
    php${PHP_VERSION}-fpm \
    php${PHP_VERSION}-gd \
    php${PHP_VERSION}-imap \
    php${PHP_VERSION}-mailparse \
    php${PHP_VERSION}-mbstring \
    php${PHP_VERSION}-mysql \
    php${PHP_VERSION}-readline \
    php${PHP_VERSION}-sqlite3 \
    php${PHP_VERSION}-xml \
    php${PHP_VERSION}-yaml \
    php${PHP_VERSION}-zip \
    php${PHP_VERSION}-zstd \
    && rm -rf /var/lib/apt/lists/*

# nginx
RUN apt update && apt install -y \
    nginx \
    && rm -rf /var/lib/apt/lists/*

RUN sed -i 's/upload_max_filesize = 2M/upload_max_filesize = 50M/' /etc/php/${PHP_VERSION}/fpm/php.ini && \
    sed -i 's/post_max_size = 8M/post_max_size = 50M/' /etc/php/${PHP_VERSION}/fpm/php.ini && \
    sed -i 's/memory_limit = 128M/memory_limit = 256M/' /etc/php/${PHP_VERSION}/fpm/php.ini && \
    sed -i 's/max_execution_time = 30/max_execution_time = 300/' /etc/php/${PHP_VERSION}/fpm/php.ini && \
    sed -i 's/expose_php = On/expose_php = Off/' /etc/php/${PHP_VERSION}/fpm/php.ini

# xlsxio
RUN apt update && apt install -y \
    zlib1g \
    expat \
    libminizip1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=xlsxio-builder /opt/xlsxio-install/usr/local /usr/local
RUN ldconfig

# ocr / office tools
RUN apt update && apt install -y \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-spa \
    tesseract-ocr-osd \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y \
    chromium \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    libreoffice-draw \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y \
    imagemagick \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y \
    poppler-utils \
    libnss3-tools \
    && rm -rf /var/lib/apt/lists/*

# cron
RUN apt update && apt install -y \
    cron \
    && rm -rf /var/lib/apt/lists/*

# saltos4 codebase
COPY code /opt/saltos4/code
COPY scripts /opt/saltos4/scripts
COPY .git /opt/saltos4/.git

# instance setup: the private directory contains the full instances and the
# public directory is the document root and only contains the index.php and
# one link to the web directory of each instance
# seed data used to populate the bind-mounted volumes on first boot
RUN cd /opt/saltos4 \
    && mkdir -p instances/private/removed instances/public \
    && cd instances \
    && ln -s ../../code private/code \
    && ln -s ../../scripts private/scripts \
    && ln -s ../../scripts/demos_index.php public/index.php \
    && cd .. \
    && chown -R www-data:www-data instances \
    && chmod -R 0755 instances \
    && mv /opt/saltos4/instances /opt/saltos4/instances-seed \
    && mkdir /opt/saltos4/instances

# nginx site: the recipe of scripts/server.nginx.conf with the public directory
RUN rm -f /etc/nginx/sites-enabled/default \
    && sed -e 's|/path/to/saltos4/code/web|/opt/saltos4/instances/public|' \
        -e "s|php[0-9.]*-fpm.sock|php${PHP_VERSION}-fpm.sock|" \
        /opt/saltos4/scripts/server.nginx.conf > /etc/nginx/sites-enabled/saltos4

# crontab: purge demos older than 7 days, running trash.php locally (no web server involved)
RUN cat <<'EOF' > /etc/cron.d/saltos4 && chmod 0644 /etc/cron.d/saltos4
MAILTO=""
0 * * * * www-data cd /opt/saltos4/instances/private && php /opt/saltos4/scripts/demos_trash.php
EOF

# entrypoint: populate the bind-mounted instances dir with symlinks on first boot, then start services
RUN cat <<'EOF' > /usr/local/bin/docker-entrypoint.sh && chmod +x /usr/local/bin/docker-entrypoint.sh
#!/bin/bash
set -e

if [ -z "$(ls -A /opt/saltos4/instances)" ]; then
    cp -a /opt/saltos4/instances-seed/. /opt/saltos4/instances/
fi

/etc/init.d/php*-fpm start
service nginx start
service cron start
exec /bin/tail -f /dev/null
EOF

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/docker-entrypoint.sh"]
