FROM debian:trixie AS xlsxio-builder

RUN apt update && apt install -y \
    build-essential \
    cmake \
    git \
    zlib1g-dev \
    expat \
    libexpat1-dev \
    libminizip-dev \
    && rm -rf /var/lib/apt/lists/*

RUN cd /tmp \
    && git clone --depth 1 https://github.com/brechtsanders/xlsxio.git \
    && cd xlsxio \
    && cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_STATIC=NO . \
    && make \
    && make install DESTDIR=/opt/xlsxio-install

FROM debian:trixie

# Preform first update and install dependencies
RUN apt update && apt install -y \
    extrepo \
    wget \
    vim \
    net-tools \
    iputils-ping \
    poppler-utils \
    libnss3-tools \
    && rm -rf /var/lib/apt/lists/*

# Enable external repos like sury and official mariadb
RUN extrepo enable sury \
    && extrepo enable mariadb-12.3

# Install MariaDB, Apache, PHP and extra tools
RUN apt update && apt install -y \
    mariadb-server \
    mariadb-client \
    apache2 \
    libapache2-mod-php8.5 \
    php8.5 \
    php8.5-bcmath \
    php8.5-cli \
    php8.5-common \
    php8.5-curl \
    php8.5-gd \
    php8.5-imap \
    php8.5-mailparse \
    php8.5-mbstring \
    php8.5-mysql \
    php8.5-readline \
    php8.5-sqlite3 \
    php8.5-xml \
    php8.5-yaml \
    php8.5-zip \
    php8.5-zstd \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-spa \
    tesseract-ocr-osd \
    chromium \
    git \
    subversion \
    libreoffice \
    imagemagick \
    zlib1g \
    expat \
    libminizip1 \
    cron \
    && rm -rf /var/lib/apt/lists/*

# Copy xlsxio built binaries/libs from the builder stage
COPY --from=xlsxio-builder /opt/xlsxio-install/usr/local /usr/local
RUN ldconfig

# Add the apache ssl support
#RUN a2enmod rewrite \
#    && a2enmod ssl \
#    && a2enmod headers \
#    && a2enmod expires \
#    && a2enmod deflate \
#    && mkdir -p /etc/apache2/ssl \
#    && openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#    -keyout /etc/apache2/ssl/apache-selfsigned.key \
#    -out /etc/apache2/ssl/apache-selfsigned.crt \
#    -subj "/C=ES/ST=Madrid/L=Madrid/O=SaltOS4/OU=Development/CN=localhost" \
#    && a2ensite default-ssl.conf

# Enable required apache modules
RUN a2enmod rewrite \
    && a2enmod headers \
    && a2enmod expires \
    && a2enmod deflate

# Configure apache
RUN echo "<Directory /var/www/html>\n\tAllowOverride All\n\tRequire all granted\n</Directory>" \
    > /etc/apache2/conf-enabled/saltos.conf

# Configure MariaDB
RUN sed -i 's/^bind-address.*/bind-address = 127.0.0.1/' /etc/mysql/mariadb.conf.d/50-server.cnf && \
    echo "[mysqld]" >> /etc/mysql/mariadb.conf.d/99-custom.cnf && \
    echo "character-set-server = utf8mb4" >> /etc/mysql/mariadb.conf.d/99-custom.cnf && \
    echo "collation-server = utf8mb4_unicode_ci" >> /etc/mysql/mariadb.conf.d/99-custom.cnf && \
    echo "max_allowed_packet = 256M" >> /etc/mysql/mariadb.conf.d/99-custom.cnf

# Configure DB credentials
RUN service mariadb start \
    && echo "CREATE DATABASE saltos CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" | mariadb \
    && echo "CREATE USER 'saltos'@'localhost' IDENTIFIED BY 'saltos';" | mariadb \
    && echo "GRANT ALL PRIVILEGES ON saltos.* TO 'saltos'@'localhost';" | mariadb \
    && service mariadb stop

# Configure PHP
RUN sed -i 's/upload_max_filesize = 2M/upload_max_filesize = 50M/' /etc/php/8.5/apache2/php.ini && \
    sed -i 's/post_max_size = 8M/post_max_size = 50M/' /etc/php/8.5/apache2/php.ini && \
    sed -i 's/memory_limit = 128M/memory_limit = 256M/' /etc/php/8.5/apache2/php.ini && \
    sed -i 's/max_execution_time = 30/max_execution_time = 300/' /etc/php/8.5/apache2/php.ini

# Checkout saltos4 code
RUN cd /opt \
    && mkdir saltos4 \
    && cd saltos4 \
    && wget -q -O - https://download.saltos.org/ | tar xvz \
    && mv SaltOS4-master/code code \
    && mv SaltOS4-master/scripts scripts \
    && rm -rf SaltOS4-master

# Create the saltos4 instance
RUN cd /opt/saltos4 \
    && mkdir instance \
    && cd instance \
    && bash /opt/saltos4/scripts/make_instance.sh \
    && cd .. \
    && chown -R www-data:www-data instance \
    && chmod -R 755 instance \
    && cd /var/www \
    && mv html html.old \
    && ln -s /opt/saltos4/instance/web html

# SaltOS setup
RUN service mariadb start \
    && php /opt/saltos4/instance/api/index.php setup \
    && user=admin php /opt/saltos4/instance/api/index.php setup/certs \
    && user=admin php /opt/saltos4/instance/api/index.php setup/company \
    && user=admin php /opt/saltos4/instance/api/index.php setup/emails \
    && user=admin php /opt/saltos4/instance/api/index.php setup/crm \
    && user=admin php /opt/saltos4/instance/api/index.php setup/hr \
    && user=admin php /opt/saltos4/instance/api/index.php setup/purchases \
    && user=admin php /opt/saltos4/instance/api/index.php setup/sales \
    && service mariadb stop

# Seed data used to populate the bind-mounted volumes on first boot
RUN mv /var/lib/mysql /var/lib/mysql-seed \
    && mv /opt/saltos4/instance/data /opt/saltos4/instance/data-seed

# Configure crontab
RUN cat <<'EOF' > /etc/cron.d/saltos4
MAILTO=""
* * * * * saltos /usr/bin/php /opt/saltos4/instance/api/index.php cron
EOF
RUN chmod 0644 /etc/cron.d/saltos4

# Entrypoint: populate empty volumes from the seed data, then start services
RUN cat <<'EOF' > /usr/local/bin/docker-entrypoint.sh
#!/bin/bash
set -e

if [ -z "$(ls -A /var/lib/mysql)" ]; then
    cp -a /var/lib/mysql-seed/. /var/lib/mysql/
fi

if [ -z "$(ls -A /opt/saltos4/instance/data)" ]; then
    cp -a /opt/saltos4/instance/data-seed/. /opt/saltos4/instance/data/
fi

if ! id saltos > /dev/null 2>&1; then
    useradd -u "${CODE_UID:-33}" -o -M -s /usr/sbin/nologin saltos
fi

service mariadb start
service apache2 start
service cron start
exec /bin/tail -f /dev/null
EOF
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

CMD ["/usr/local/bin/docker-entrypoint.sh"]
