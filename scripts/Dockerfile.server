
ARG MARIADB_VERSION=12.3
ARG MROONGA_VERSION=16.11
ARG PHP_VERSION=8.5

####################################################################################################
# xlsxio builder
####################################################################################################

FROM debian:trixie AS xlsxio-builder

RUN apt update && apt install -y \
    build-essential \
    cmake \
    git \
    zlib1g-dev \
    expat \
    libexpat1-dev \
    libminizip-dev \
    && rm -rf /var/lib/apt/lists/*

RUN cd /tmp \
    && git clone --depth 1 https://github.com/brechtsanders/xlsxio.git \
    && cd xlsxio \
    && cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_STATIC=NO . \
    && make \
    && make install DESTDIR=/opt/xlsxio-install

####################################################################################################
# mroonga builder
####################################################################################################

FROM debian:trixie AS mroonga-builder

ARG MARIADB_VERSION
ARG MROONGA_VERSION

RUN apt update && apt install -y \
    curl \
    ca-certificates \
    extrepo \
    git \
    cmake \
    ninja-build \
    build-essential \
    pkg-config \
    bison \
    flex \
    libncurses-dev \
    zlib1g-dev \
    libpcre2-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://packages.apache.org/artifactory/arrow/debian/apache-arrow-apt-source-latest-trixie.deb -o /tmp/arrow.deb \
    && apt update && apt install -y /tmp/arrow.deb \
    && rm /tmp/arrow.deb

RUN curl -fsSL https://packages.groonga.org/debian/groonga-apt-source-latest-trixie.deb -o /tmp/groonga.deb \
    && apt update && apt install -y /tmp/groonga.deb \
    && rm /tmp/groonga.deb

RUN extrepo enable mariadb-${MARIADB_VERSION}

RUN apt update && apt install -y \
    libgroonga-dev \
    groonga-normalizer-mysql \
    libmariadb-dev \
    mariadb-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp

RUN VERSION=$(mariadb --version | grep -oP '\d+\.\d+\.\d+') && \
    git clone --depth 1 --branch "mariadb-${VERSION}" https://github.com/MariaDB/server.git mariadb-src && \
    mkdir -p mariadb-src/builddir && \
    cd mariadb-src/builddir && \
    cmake .. -GNinja -DCMAKE_BUILD_TYPE=Release && \
    ninja GenError

RUN git clone --depth 1 --branch "v${MROONGA_VERSION}" https://github.com/mroonga/mroonga.git /tmp/mroonga

WORKDIR /tmp/mroonga

RUN cmake . \
       -GNinja \
       -DCMAKE_BUILD_TYPE=Release \
       -DMRN_WITH_DOC=OFF \
       -DMYSQL_SOURCE_DIR="/tmp/mariadb-src" \
       -DMYSQL_BUILD_DIR="/tmp/mariadb-src/builddir" \
       -DMYSQL_CONFIG=/usr/bin/mariadb_config \
    && cmake --build .

RUN mkdir -p /opt/mroonga-install \
    && cp ha_mroonga.so /opt/mroonga-install/ \
    && cat data/install.sql data/update.sql | grep -v source > /opt/mroonga-install/install.sql \
    && cp data/uninstall.sql /opt/mroonga-install/

####################################################################################################
# default builder
####################################################################################################

FROM debian:trixie

ARG MARIADB_VERSION
ARG PHP_VERSION

RUN echo 'path-exclude /usr/share/doc/*' > /etc/dpkg/dpkg.cfg.d/01_nodoc && \
    echo 'path-exclude /usr/share/man/*' >> /etc/dpkg/dpkg.cfg.d/01_nodoc && \
    echo 'path-exclude /usr/share/locale/*' >> /etc/dpkg/dpkg.cfg.d/01_nodoc && \
    echo 'APT::Install-Recommends "false";' > /etc/apt/apt.conf.d/00_nofilters && \
    echo 'APT::Install-Suggests "false";' >> /etc/apt/apt.conf.d/00_nofilters

RUN apt update && apt install -y \
    extrepo \
    wget \
    vim \
    net-tools \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

RUN extrepo enable sury
RUN extrepo enable mariadb-${MARIADB_VERSION}

# php
RUN apt update && apt install -y \
    php${PHP_VERSION}-bcmath \
    php${PHP_VERSION}-cli \
    php${PHP_VERSION}-common \
    php${PHP_VERSION}-curl \
    php${PHP_VERSION}-gd \
    php${PHP_VERSION}-imap \
    php${PHP_VERSION}-mailparse \
    php${PHP_VERSION}-mbstring \
    php${PHP_VERSION}-mysql \
    php${PHP_VERSION}-readline \
    php${PHP_VERSION}-sqlite3 \
    php${PHP_VERSION}-xml \
    php${PHP_VERSION}-yaml \
    php${PHP_VERSION}-zip \
    php${PHP_VERSION}-zstd \
    && rm -rf /var/lib/apt/lists/*

# apache
RUN apt update && apt install -y \
    apache2 \
    libapache2-mod-php${PHP_VERSION} \
    && rm -rf /var/lib/apt/lists/*

RUN sed -i 's/upload_max_filesize = 2M/upload_max_filesize = 50M/' /etc/php/${PHP_VERSION}/apache2/php.ini && \
    sed -i 's/post_max_size = 8M/post_max_size = 50M/' /etc/php/${PHP_VERSION}/apache2/php.ini && \
    sed -i 's/memory_limit = 128M/memory_limit = 256M/' /etc/php/${PHP_VERSION}/apache2/php.ini && \
    sed -i 's/max_execution_time = 30/max_execution_time = 300/' /etc/php/${PHP_VERSION}/apache2/php.ini

RUN a2enmod rewrite \
    && a2enmod headers \
    && a2enmod expires \
    && a2enmod deflate \
    && a2enmod php${PHP_VERSION}

RUN echo "<Directory /var/www/html>\n\tAllowOverride All\n\tRequire all granted\n</Directory>" \
    > /etc/apache2/conf-enabled/saltos.conf

# mariadb + mroonga
RUN apt update && apt install -y \
    mariadb-server \
    mariadb-client \
    && mv /var/lib/mysql /var/lib/mysql-seed \
    && mkdir /var/lib/mysql \
    && chown mysql:mysql /var/lib/mysql \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://packages.apache.org/artifactory/arrow/debian/apache-arrow-apt-source-latest-trixie.deb -o /tmp/arrow.deb \
    && apt update && apt install -y /tmp/arrow.deb \
    && rm /tmp/arrow.deb

RUN curl -fsSL https://packages.groonga.org/debian/groonga-apt-source-latest-trixie.deb -o /tmp/groonga.deb \
    && apt update && apt install -y /tmp/groonga.deb \
    && rm /tmp/groonga.deb

RUN apt update && apt install -y \
    libgroonga0 \
    groonga-normalizer-mysql \
    && rm -rf /var/lib/apt/lists/*

COPY --from=mroonga-builder /opt/mroonga-install/ /usr/lib/mysql/plugin/

RUN sed -i 's/^bind-address.*/bind-address = 127.0.0.1/' /etc/mysql/mariadb.conf.d/50-server.cnf && \
    echo "[mysqld]" >> /etc/mysql/mariadb.conf.d/99-custom.cnf && \
    echo "character-set-server = utf8mb4" >> /etc/mysql/mariadb.conf.d/99-custom.cnf && \
    echo "collation-server = utf8mb4_unicode_ci" >> /etc/mysql/mariadb.conf.d/99-custom.cnf && \
    echo "max_allowed_packet = 256M" >> /etc/mysql/mariadb.conf.d/99-custom.cnf

# xlsxio
RUN apt update && apt install -y \
    zlib1g \
    expat \
    libminizip1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=xlsxio-builder /opt/xlsxio-install/usr/local /usr/local
RUN ldconfig

# ocr / office tools
RUN apt update && apt install -y \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-spa \
    tesseract-ocr-osd \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y \
    chromium \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    libreoffice-draw \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y \
    imagemagick \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y \
    poppler-utils \
    libnss3-tools \
    && rm -rf /var/lib/apt/lists/*

# cron & tini
RUN apt update && apt install -y \
    cron \
    tini \
    && rm -rf /var/lib/apt/lists/*

# saltos4 codebase
COPY code /opt/saltos4/code
COPY scripts /opt/saltos4/scripts
COPY .git /opt/saltos4/.git

# instance setup
RUN cd /opt/saltos4 \
    && mkdir instance \
    && cd instance \
    && bash /opt/saltos4/scripts/make_instance.sh \
    && mv data data-seed \
    && mkdir data \
    && mkdir wait \
    && cd wait \
    && ln -s /opt/saltos4/scripts/wait_index.html index.html \
    && cd .. \
    && cd .. \
    && chown -R www-data:www-data instance \
    && chmod -R 0755 instance \
    && chown www-data:www-data /var/www \
    && cd /var/www \
    && mv html html.old \
    && ln -s /opt/saltos4/instance/web html

# crontab
RUN cat <<'EOF' > /etc/cron.d/saltos4 && chmod 0644 /etc/cron.d/saltos4
MAILTO=""
* * * * * saltos /usr/bin/php /opt/saltos4/instance/api/index.php cron
EOF

# entrypoint: populate empty volumes from the seed data, then start services
RUN cat <<'EOF' > /usr/local/bin/docker-entrypoint.sh && chmod +x /usr/local/bin/docker-entrypoint.sh
#!/bin/bash
set -e

if ! id saltos > /dev/null 2>&1; then
    useradd -u "${CODE_UID:-33}" -o -M -s /usr/sbin/nologin saltos
fi

if [ -z "$(ls -A /var/lib/mysql)" ] && [ -z "$(ls -A /opt/saltos4/instance/data)" ]; then
    php -S 0.0.0.0:80 -t /opt/saltos4/instance/wait &
    WAIT_PID=$!

    cp -a /var/lib/mysql-seed/. /var/lib/mysql/
    chown -R mysql:mysql /var/lib/mysql

    cp -a /opt/saltos4/instance/data-seed/. /opt/saltos4/instance/data/
    chown -R www-data:www-data /opt/saltos4/instance/data

    service mariadb start

    echo "CREATE DATABASE saltos CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" | mariadb
    echo "CREATE USER 'saltos'@'localhost' IDENTIFIED BY 'saltos';" | mariadb
    echo "GRANT ALL PRIVILEGES ON saltos.* TO 'saltos'@'localhost';" | mariadb
    cat /usr/lib/mysql/plugin/install.sql | mariadb

    php /opt/saltos4/instance/api/index.php setup
    user=admin php /opt/saltos4/instance/api/index.php setup/certs
    user=admin php /opt/saltos4/instance/api/index.php setup/company
    user=admin php /opt/saltos4/instance/api/index.php setup/emails
    user=admin php /opt/saltos4/instance/api/index.php setup/crm
    user=admin php /opt/saltos4/instance/api/index.php setup/hr
    user=admin php /opt/saltos4/instance/api/index.php setup/purchases
    user=admin php /opt/saltos4/instance/api/index.php setup/sales

    kill "$WAIT_PID" || true
    wait "$WAIT_PID" || true
fi

if [ -n "$(ls -A /var/lib/mysql)" ]; then
    service mariadb start
fi

service apache2 start
service cron start
exec /bin/tail -f /dev/null
EOF

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/docker-entrypoint.sh"]
